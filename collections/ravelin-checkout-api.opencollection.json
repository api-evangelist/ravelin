{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ravelin Server 3D Secure Checkout API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Checkout",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Score a Checkout Event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://3ds.live.pci.ravelin.com/v2/checkout",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit an order at checkout to receive a real-time risk decision before payment is captured. Recommended as the primary pre-payment integration point."
        }
      ]
    }
  ],
  "bundled": true
}